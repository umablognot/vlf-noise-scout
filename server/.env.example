# Leave blank to use the default ALSA capture device.
# Run `python -m sounddevice` to list devices.
VLF_DEVICE=
VLF_SAMPLE_RATE=48000
VLF_BLOCK_SIZE=512
VLF_LOW_CUT_HZ=250
VLF_HIGH_CUT_HZ=12000
VLF_ADAPT_RATE=0.035
VLF_CANCEL_STRENGTH=0.88
VLF_COHERENCE_FLOOR=0.18
VLF_TRANSIENT_FREEZE_RATIO=3.8
VLF_MP3_BITRATE=64k
# Conservative public-demo default for a home upload link.
VLF_MAX_LISTENERS=12
VLF_MOCK_MODE=0
# Comma-separated. Use your exact Pages origin in production.
VLF_ALLOWED_ORIGINS=*
