#. UI string guide4_s
msgid "guide4_s"
msgstr "Kalın sürekli vınlama"

#. UI string guide4_d
msgid "guide4_d"
msgstr ""
"50 Hz ve harmonikleri — doğal değil, evin elektriği. Temiz kanalda "
"bastırılır; Ham'a geçince duyulur."

#. UI string guide5_t
