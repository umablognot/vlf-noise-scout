msgstr "Capture the last 60 seconds"

#. UI string “recAudio”
msgid "recAudio"
msgstr "Download audio"

#. UI string “recImage”
msgid "recImage"
msgstr "Download waterfall"

#. UI string “recNote”
msgid "recNote"
msgstr ""
"While the stream plays, the last 60 seconds are continuously buffered — "
"press the button after you hear something interesting."

#. UI string “recWait”
msgid "recWait"
msgstr "Buffer still filling… try again in a few seconds."

#. UI string “recDone”
msgid "recDone"
